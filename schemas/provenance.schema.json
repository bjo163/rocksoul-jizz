{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rocksoul.dev/jizz/schemas/provenance.schema.json",
  "title":"JIZZ Provenance",
  "x-jizz-schema-version":"jizz.provenance.v0.1",
  "type":"object",
  "required":["schema_version","id","record_type","domain","source_ids","observation_ids","research_run_id","created_at"],
  "properties":{
    "schema_version":{"const":"jizz.provenance.v0.1"},
    "id":{"type":"string","pattern":"^PROV-JIZZ-[A-Z0-9-]+$"},
    "record_type":{"const":"PROVENANCE"},
    "domain":{"const":"PERSPECTIVE"},
    "source_ids":{"type":"array","items":{"type":"string"}},
    "observation_ids":{"type":"array","items":{"type":"string"}},
    "research_run_id":{"type":"string","pattern":"^RRUN-JIZZ-[A-Z0-9-]+$"},
    "notes":{"type":"string"},
    "created_at":{"type":"string","format":"date-time"}
  },
  "additionalProperties":false
}
