{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rocksoul.dev/jizz/schemas/change.schema.json",
  "title":"JIZZ Change",
  "x-jizz-schema-version":"jizz.change.v0.1",
  "type":"object",
  "required":["schema_version","id","record_type","domain","phenomenon_id","from","to","dimensions","input_signal_ids","input_observation_ids","methodology_id","algorithm_version","confidence","generated_at","provenance_id"],
  "properties":{
    "schema_version":{"const":"jizz.change.v0.1"},
    "id":{"type":"string","pattern":"^CHG-JIZZ-[A-Z0-9-]+$"},
    "record_type":{"const":"CHANGE"},
    "domain":{"const":"PERSPECTIVE"},
    "phenomenon_id":{"type":"string"},
    "from":{"type":"string","format":"date-time"},
    "to":{"type":"string","format":"date-time"},
    "dimensions":{"type":"object","properties":{"VOLUME":{"type":"number"},"VELOCITY":{"type":"number"},"GEOGRAPHY":{"type":"number"},"FRAMING":{"type":"number"},"POSITION":{"type":"number"},"ACTOR_DIVERSITY":{"type":"number"},"SOURCE_DIVERSITY":{"type":"number"},"PERSPECTIVE_DIVERSITY":{"type":"number"},"DISAGREEMENT":{"type":"number"},"CONVERGENCE":{"type":"number"}},"additionalProperties":false},
    "input_signal_ids":{"type":"array","items":{"type":"string"}},
    "input_observation_ids":{"type":"array","items":{"type":"string"}},
    "methodology_id":{"type":"string"},
    "algorithm_version":{"type":"string"},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "summary":{"type":"string"},
    "generated_at":{"type":"string","format":"date-time"},
    "provenance_id":{"type":"string"}
  },
  "additionalProperties":false
}
