{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rocksoul.dev/jizz/schemas/perspective.schema.json",
  "title":"JIZZ Perspective",
  "x-jizz-schema-version":"jizz.perspective.v0.1",
  "type":"object",
  "required":["schema_version","id","record_type","domain","phenomenon_id","actor_reference","actor_type","zone","geography","audience_scope","framing_ids","position","salience","observed_at","valid_from","observation_refs","provenance_id"],
  "properties":{
    "schema_version":{"const":"jizz.perspective.v0.1"},
    "id":{"type":"string","pattern":"^PERSP-JIZZ-[A-Z0-9-]+$"},
    "record_type":{"const":"PERSPECTIVE"},
    "domain":{"const":"PERSPECTIVE"},
    "phenomenon_id":{"type":"string"},
    "actor_reference":{"type":"string","minLength":1},
    "actor_type":{"enum":["MEDIA","GOVERNMENT","CORPORATE","SCIENTIFIC","ACADEMIC","COMMUNITY","CREATOR","ACTIVIST","PUBLIC","INVESTOR","LEGAL","CULTURAL","TECHNICAL","LOCAL","GLOBAL","UNKNOWN"]},
    "zone":{"enum":["GLOBAL","REGIONAL","LOCAL","DIGITAL","CULTURAL","TECHNICAL","POLITICAL","ECONOMIC","SCIENTIFIC","COMMUNITY"]},
    "geography":{"type":"string"},
    "audience_scope":{"type":"string"},
    "summary":{"type":"string"},
    "framing_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^FRAME-JIZZ-[A-Z0-9-]+$"}},
    "position":{"enum":["SUPPORT","OPPOSE","NEUTRAL","MIXED","QUESTIONING","UNKNOWN"]},
    "salience":{"type":"number","minimum":0,"maximum":1},
    "observed_at":{"type":"string","format":"date-time"},
    "valid_from":{"type":"string","format":"date-time"},
    "valid_until":{"type":["string","null"],"format":"date-time"},
    "observation_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "provenance_id":{"type":"string"}
  },
  "additionalProperties":false
}
