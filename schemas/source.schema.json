{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rocksoul.dev/jizz/schemas/source.schema.json",
  "title":"JIZZ Source",
  "x-jizz-schema-version":"jizz.source.v0.1",
  "type":"object",
  "required":["schema_version","id","record_type","domain","source_type","publisher","published_at","retrieved_at","language","content_hash","freshness","provenance_id"],
  "properties":{
    "schema_version":{"const":"jizz.source.v0.1"},
    "id":{"type":"string","pattern":"^SRC-JIZZ-[A-Z0-9-]+$"},
    "record_type":{"const":"SOURCE"},
    "domain":{"const":"PERSPECTIVE"},
    "source_type":{"type":"string","enum":["ARTICLE","POST","TRANSCRIPT","REPORT","STATEMENT","DATASET","OTHER"]},
    "publisher":{"type":"string","minLength":1},
    "author":{"type":["string","null"]},
    "organization":{"type":["string","null"]},
    "url":{"type":["string","null"],"format":"uri"},
    "published_at":{"type":"string","format":"date-time"},
    "retrieved_at":{"type":"string","format":"date-time"},
    "language":{"type":"string","minLength":2},
    "country":{"type":["string","null"]},
    "region":{"type":["string","null"]},
    "content_hash":{"type":"string","minLength":8},
    "freshness":{"enum":["FRESH","AGING","STALE","UNAVAILABLE"]},
    "metadata":{"type":"object"},
    "provenance_id":{"type":"string"}
  },
  "additionalProperties":false
}
