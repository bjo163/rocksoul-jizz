{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rocksoul.dev/jizz/schemas/trend.schema.json",
  "title":"JIZZ Trend",
  "x-jizz-schema-version":"jizz.trend.v0.1",
  "type":"object",
  "required":["schema_version","id","record_type","domain","phenomenon_id","state","input_signal_ids","input_change_ids","methodology_id","confidence","generated_at","provenance_id"],
  "properties":{
    "schema_version":{"const":"jizz.trend.v0.1"},
    "id":{"type":"string","pattern":"^TREND-JIZZ-[A-Z0-9-]+$"},
    "record_type":{"const":"TREND"},
    "domain":{"const":"PERSPECTIVE"},
    "phenomenon_id":{"type":"string"},
    "state":{"enum":["EMERGING","RISING","PEAKING","STABLE","DECLINING","RESURGING","DORMANT"]},
    "input_signal_ids":{"type":"array","items":{"type":"string"}},
    "input_change_ids":{"type":"array","items":{"type":"string"}},
    "methodology_id":{"type":"string"},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "generated_at":{"type":"string","format":"date-time"},
    "provenance_id":{"type":"string"}
  },
  "additionalProperties":false
}
